# ==============================================================
#  BlenderRenderServer - Einstellungen
#  Diese Datei kannst du mit einem Doppelklick auf
#  06_config_bearbeiten.bat bequem im Editor bearbeiten.
#  Nach Aenderungen den Server mit 03_stop.bat + 02_start.bat
#  neu starten.
# ==============================================================

# ---------- Server ----------
# Port, unter dem der Server erreichbar ist (Standard 8000).
# Roblox Studio muss in den Lua-Skripten dieselbe Adresse verwenden.
BRS_PORT=8000

# ---------- Roblox (seit Maerz 2026 PFLICHT fuer 3D-Avatare) ----------
# Open-Cloud-API-Key mit Recht "thumbnails: Read".
# Ohne diesen Key antwortet Roblox auf den 3D-Modell-Download mit HTTP 403.
# Anlegen: https://create.roblox.com/dashboard/credentials
#   Create API Key -> Access Permissions: System "thumbnails", Operation "Read"
# Optional zusaetzlich: "asset-legacy-delivery: Read" als Ausweichweg.
# Den Key OHNE Anfuehrungszeichen in einer Zeile eintragen:
ROBLOX_API_KEY=

# ---------- Veroeffentlichte Spiele ----------
# Studio auf diesem PC: http://localhost:8000 (steht im Lua-Skript).
# Im echten Roblox-Client zeigt localhost NICHT auf deinen PC!
# Loesung: 08_oeffentliche_adresse.bat starten und die https-URL
# im Lua-Skript bei RENDER_SERVER_URL eintragen.
# Alternativ hier eine feste eigene HTTPS-URL (VPS / Named Tunnel):
PUBLIC_URL=
# true = beim Serverstart automatisch einen Cloudflare-Quick-Tunnel oeffnen
BRS_PUBLIC_TUNNEL=false
# Gemeinsames Geheimnis. Wenn gesetzt, muss das Lua-Skript denselben
# Wert bei RENDER_ACCESS_TOKEN haben. Sehr empfohlen bei oeffentlicher URL!
BRS_ACCESS_TOKEN=

# ---------- Rendering ----------
# Aufloesung (max. 1024, wegen EditableImage in Roblox)
RENDER_WIDTH=1024
RENDER_HEIGHT=1024
# Anzahl Samples: mehr = schoener, aber langsamer (96 ist ein guter Mittelwert)
RENDER_SAMPLES=96
# Material: glass = ganzer Avatar in Glas | original = Original-Texturen
RENDER_MATERIAL=glass
# Hintergrund: false = Himmelshintergrund (sieht bei Glas am besten aus)
#              true  = transparentes PNG (Glas wirkt sehr geisterhaft!)
RENDER_TRANSPARENT_BG=false
# Geraet: CPU = immer sicher | GPU = schneller, falls eine starke Grafikkarte da ist
RENDER_DEVICE=CPU

# ---------- Blender ----------
# Leer lassen, dann wird tools/blender automatisch benutzt (01_setup.bat).
# Nur ausfuellen, wenn Blender woanders installiert ist:
BLENDER_PATH=

# ---------- Auto-Update ----------
# true = Server laedt automatisch neue Versionen vom GitHub-Haupt-Branch,
# sobald dort Aenderungen (z. B. gemergte Pull Requests) ankommen.
# Wenn "GitHub nicht erreichbar" kommt: Rendern geht trotzdem.
# Dann entweder Firewall fuer github.com erlauben oder auf false stellen.
AUTO_UPDATE=true
# Alle wie viele Sekunden geprueft wird (Standard: 300 = 5 Minuten)
AUTO_UPDATE_CHECK_SECONDS=300
GITHUB_REPO=mertastudios/BlenderRenderServer
GITHUB_BRANCH=main

# ---------- Fehlersuche ----------
# true = statt eines echten Roblox-Avatars wird eine offline Testfigur
# gerendert (nuetzlich, um das System ohne Roblox zu testen)
BRS_TEST_MODE=false
