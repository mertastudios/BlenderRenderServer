# ==============================================================
#  BlenderRenderServer - Einstellungen
#  Diese Datei kannst du mit einem Doppelklick auf
#  06_config_bearbeiten.bat bequem im Editor bearbeiten.
#  Nach Aenderungen den Server mit 03_stop.bat + 02_start.bat
#  neu starten.
# ==============================================================

# ---------- Server ----------
# Port, unter dem der Server erreichbar ist (Standard 8000).
# Roblox Studio muss in den Lua-Skripten dieselbe Adresse verwenden.
BRS_PORT=8000

# ---------- Roblox (optional) ----------
# Roblox Open Cloud API-Key mit Lese-Recht "asset-legacy-delivery".
# Wird automatisch als Zusatzweg fuer Asset-Downloads genutzt.
# Kann leer bleiben - der Avatar-Download funktioniert auch ohne Key!
ROBLOX_API_KEY=

# ---------- Rendering ----------
# Aufloesung (max. 1024, wegen EditableImage in Roblox)
RENDER_WIDTH=1024
RENDER_HEIGHT=1024
# Anzahl Samples: mehr = schoener, aber langsamer (96 ist ein guter Mittelwert)
RENDER_SAMPLES=96
# Material: glass = ganzer Avatar in Glas | original = Original-Texturen
RENDER_MATERIAL=glass
# Hintergrund: false = Himmelshintergrund (sieht bei Glas am besten aus)
#              true  = transparentes PNG (Glas wirkt sehr geisterhaft!)
RENDER_TRANSPARENT_BG=false
# Geraet: CPU = immer sicher | GPU = schneller, falls eine starke Grafikkarte da ist
RENDER_DEVICE=CPU

# ---------- Blender ----------
# Leer lassen, dann wird tools/blender automatisch benutzt (01_setup.bat).
# Nur ausfuellen, wenn Blender woanders installiert ist:
BLENDER_PATH=

# ---------- Auto-Update ----------
# true = Server laedt automatisch neue Versionen vom GitHub-Haupt-Branch,
# sobald dort Aenderungen (z. B. gemergte Pull Requests) ankommen.
AUTO_UPDATE=true
# Alle wie viele Sekunden geprueft wird (Standard: 300 = 5 Minuten)
AUTO_UPDATE_CHECK_SECONDS=300
GITHUB_REPO=mertastudios/BlenderRenderServer
GITHUB_BRANCH=main

# ---------- Fehlersuche ----------
# true = statt eines echten Roblox-Avatars wird eine offline Testfigur
# gerendert (nuetzlich, um das System ohne Roblox zu testen)
BRS_TEST_MODE=false
